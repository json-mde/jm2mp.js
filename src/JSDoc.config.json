{
  "plugins": [
    "plugins/markdown",
    "plugins/summarize"
  ],
  "sourceType": "module",
  "opts": {
    "access": "all",
    "private": true,
    "template": "templates/default",
    "encoding": "utf8",
    "destination": "../doc/jsdoc-out/",
    "recurse": true,
    "tutorials": "../doc/tutorials/",
    "readme": "../README.md",
    "package": "./package.json",
    "verbose": true
  },
  "recurseDepth": 100,
  "source": {
    "include": [ "./" ],
    "exclude": [ "./node_modules/", "./test/" ],
    "includePattern": ".+\\.(c|m)?js(doc|x)?$",
    "excludePattern": "(node_modules)|(test)|((^|\\/|\\\\)_)"
  },
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": [ "jsdoc", "closure" ]
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "default": {
      "layoutFile": "../doc/layout.tmpl",
      "staticFiles": {
        "include": [
          "../doc/static/",
          "../LICENSE.txt"
        ]
      }
    }
  }
}
