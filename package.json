{
  "name": "@json-mde/jm2mp",
  "version": "1.0.0",
  "description": "JSON Model-to-Model Projection (JM2MP) JavaScript library (JM2MP.JS).",
  "license": "BSD-3-Clause",
  "author": {
    "name": "Luis Maria CAMARA ROSSI",
    "email": "lcamara8@alumno.uned.es",
    "url": "https://www.uned.es/universidad/facultades/en/departamentos/ingenieria-del-softw-y-sist-informaticos.html"
  },
  "contributors": [
    {
      "name": "Elena RUIZ LARROCHA",
      "url": "https://www.uned.es/universidad/docentes/informatica/elena-ruiz-larrocha.html"
    },
    {
      "name": "Jose Antonio CERRADA SOMOLINOS",
      "url": "https://www.uned.es/universidad/docentes/informatica/jose-antonio-cerrada-somolinos.html"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSON-MDE/JM2MP.JS.git"
  },
  "homepage": "https://github.com/JSON-MDE/JM2MP.JS#readme",
  "bugs": {
    "url": "https://github.com/JSON-MDE/JM2MP.JS/issues"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schemas/JM2MP-v1.0.0--JSON-Schema-Draft-2020-12.json"
  },
  "files": [
    "./README.md",
    "./LICENSE.txt",
    "./CHANGELOG.md",
    "./src/errors.js", "./src/evaluator.js", "./src/index.js", "./src/validator.js",
    "./src/adapters/*.js", "./src/modules/*.js", "./src/schemas/*.json"
  ],
  "scripts": {
    "all": "npm run test:coverage && npm run eslint && npm run jsdoc",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:coverage-lcov": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage.lcov",
    "eslint": "npx -- eslint",
    "jsdoc": "npm run jsdoc@windows",
    "jsdoc@windows": "( IF EXIST .\\doc\\jsdoc-out\\ DEL /Q /F /S .\\doc\\jsdoc-out\\ ) && ( COPY /B .\\README.md + .\\CHANGELOG.md .\\README_CHANGELOG.md ) && ( .\\node_modules\\.bin\\jsdoc.cmd --configure .\\JSDoc.config.json ) & ( DEL .\\README_CHANGELOG.md )",
    "jsdoc@linux": "( rm -rf ./doc/jsdoc-out/ ) && ( cat ./README.md ./CHANGELOG.md > ./README_CHANGELOG.md ) && ( ./node_modules/.bin/jsdoc --configure ./JSDoc.config.json ) && ( rm -f ./README_CHANGELOG.md )",
    "ajv": "npm run ajv@windows",
    "ajv@windows": "( npx -- ajv-cli --spec=draft2020 -s .\\src\\schemas\\JM2MP-v1.0.0--JSON-Schema-Draft-2020-12.json -d .\\examples\\courses-students\\projection.json ) && ( npx -- ajv-cli --spec=draft2020 -s .\\src\\schemas\\JM2MP-v1.0.0--JSON-Schema-Draft-2020-12.json -d .\\examples\\inventory\\projection.json )",
    "ajv@linux": "( npx -- ajv-cli --spec=draft2020 -s ./src/schemas/JM2MP-v1.0.0--JSON-Schema-Draft-2020-12.json -d ./examples/courses-students/projection.json ) && ( npx -- ajv-cli --spec=draft2020 -s ./src/schemas/JM2MP-v1.0.0--JSON-Schema-Draft-2020-12.json -d ./examples/inventory/projection.json )"
  },
  "optionalDependencies": {
    "@jsonquerylang/jsonquery": "4.x",
    "jmespath": "0.16.x",
    "json-pointer": "0.6.x",
    "jsonata": "^2.0.4",
    "jsonpath-plus": "^10.3.0"
  },
  "devDependencies": {
    "tidy-jsdoc": "^1.4.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0"
  },
  "keywords": [
    "jm2mp",
    "json",
    "model",
    "models",
    "projection",
    "projections",
    "transformation",
    "transformations",
    "algebra",
    "algebraic",
    "declarative",
    "functional",
    "jsonpath",
    "jsonata",
    "jsonquery",
    "jsonpointer",
    "rfc6901",
    "jmespath"
  ]
}
