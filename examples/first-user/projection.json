{
  "@" : {
      "$op": "fold",
      "$over": { "$op": "get", "$path": "$.Usuarios" },
      "$init": null,
      "$step": {
        "$op": "if",
        "$cond": {
          "$op": "eq",
          "$left":  { "$op": "get", "$path": "@.index" },
          "$right": 0
        },
        "$then": { "$op": "get", "$path": "@.item" },
        "$else": { "$op": "get", "$path": "@.acc" }
      }
  }
}
