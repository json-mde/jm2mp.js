{
  "plugins": [
    "plugins/markdown",
    "____plugins/summarize"
  ],
  "markdown": {
    "tags": [ "file" ],
    "idInHeadings ": true
  },
  "sourceType": "module",
  "opts": {
    "access": "all",
    "private": true,
    "___template": "templates/default",
    "template": "./node_modules/tidy-jsdoc",
    "prism-theme": "prism-default",
    "encoding": "utf8",
    "destination": "./doc/jsdoc-out/",
    "recurse": true,
    "tutorials": "./doc/jsdoc/tutorials/",
    "readme": "./README_CHANGELOG.md",
    "package": "./package.json",
    "verbose": true
  },
  "recurseDepth": 100,
  "source": {
    "include": [ "./src/" ],
    "exclude": [ "node_modules/", "./src/test/", "json-pointer-rfc6901--processor.js" ],
    "includePattern": ".+\\.(c|m)?js(doc|x)?$",
    "excludePattern": "(node_modules/)|(test/)|(json-pointer-rfc6901--processor\\.js)|((^|\\/|\\\\)_)|(\\.test\\.)"
  },
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": [ "jsdoc", "closure" ]
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "default": {
      "___layoutFile": "./doc/layout.tmpl",
      "includeDate": true,
      "LCamara8_Footer": true,
      "staticFiles": {
        "include": [
          "./doc/jsdoc/static/",
          "./examples/",
          "./src/schemas/",
          "./LICENSE.txt"
        ]
      }
    }
  },
  "metadata": {
    "title": "JSON Model-to-Model Projection (JM2MP) Documentation",
    "logo": "./images/JM2MP-Logo.png"
  }
}
